&lt;p&gt;解码后:&lt;/p&gt;
&lt;p&gt;var _0 = [81, 67, 67, 84, 70, 95, 86, 73, 80, 95, 50, 48, 50, 54];  // &amp;ldquo;QCCTF_VIP_2026&amp;rdquo;&lt;/p&gt;
&lt;p&gt;var _1 = [47, 102, 108, 97, 103];  // &amp;ldquo;/flag&amp;rdquo;&lt;/p&gt;
&lt;p&gt;var _2 = [86, 73, 80, 95, 78, 79, 84, 95, 72, 69, 82, 69];  // &amp;ldquo;VIP_NOT_HERE&amp;rdquo;&lt;/p&gt;
&lt;p&gt;代码分析:&lt;/p&gt;
&lt;p&gt;String.fromCharCode()函数:将ASCII数字数组转换为字符串&lt;/p&gt;
